{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freshtrack-recipes",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_LIMITER",
        "class_name": "UsageLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UsageLimiter"]
    }
  ]
}
